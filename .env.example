# Copy to .env and fill in. Never commit .env.
PORT=8080
NODE_ENV=development

# Comma-separated. The frontend sends credentials, so this cannot be "*".
# In production set the real origin(s), e.g. https://materialdepot.in
CORS_ORIGINS=http://localhost:3000

# Session cookie scope. Leave as lax when the frontend shares a registrable domain
# with this backend (materialdepot.in + api.materialdepot.in). Set to "none" if the
# frontend is on a different site (e.g. *.vercel.app) — otherwise the browser
# silently drops the cookie and login appears to work locally but not in production.
# "none" forces secure: true, so the backend must be on HTTPS.
COOKIE_SAMESITE=lax

# Shopify — same names material-frontend already uses in .env.local
SHOPIFY_STORE_DOMAIN=

# Custom app credentials. The Admin API token is NOT configured here: it is minted
# from these on demand via the client_credentials grant and expires every ~24h, so
# any token pasted into a file is stale by tomorrow. See lib/adminToken.js.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2024-10

# MSG91. Reusing Lucira's template for testing — swap MSG91_TEMPLATE_ID once the
# Material template is whitelisted on DLT, or the OTP SMS goes out under Lucira's
# sender ID.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Signs the short-lived proof that a number passed OTP, so /register cannot be
# called for a number the caller never verified. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PROOF_SECRET=

RATE_LIMIT_MAX=60

# QA only. A fixed OTP for these numbers: no SMS is sent and the code below always verifies.
# Inert unless BOTH are set. This is a backdoor into these accounts — never list a real customer's
# number, and clear TEST_OTP_MOBILES before the site is public. The backend warns at boot when on.
TEST_OTP_MOBILES=
TEST_OTP_CODE=

# Encrypts the per-customer Shopify password so a login does not invalidate other sessions.
# Without it, every sign-in rotates the password and logs the customer out everywhere else.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_PASSWORD_KEY=

# Razorpay. Test keys from dashboard.razorpay.com -> Settings -> API Keys.
# The secret signs and verifies payments — it must never reach the browser. Only KEY_ID does, and the
# backend hands that to the client at order time rather than the frontend holding its own copy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
